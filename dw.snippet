<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets  xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>dw</Title>
			<Shortcut>dw</Shortcut>
			<Description>Code snippet for Debug.WriteLine</Description>
			<Author>Nikhil R</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
		    <Imports>
				<Import>
					<Namespace>System.Diagnostics</Namespace>
				</Import>
			</Imports>
			<Declarations>
			<Literal>
					<ID>string</ID>
					<ToolTip>String to display</ToolTip>
					<Default>"Test"</Default>
				</Literal>
				<Literal Editable="false">
					<ID>Debug</ID>
					<Function>SimpleTypeName(global::System.Diagnostics.Debug)</Function>
				</Literal>
			</Declarations>
			<Code Language="csharp"><![CDATA[$Debug$.WriteLine($string$);$end$]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>